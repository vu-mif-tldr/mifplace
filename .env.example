# Copy to .env for local development: cp .env.example .env (npm run setup does it).
# One file for the whole repository: the backend, the db scripts, the tools and the MCP server read it.
# Real environment variables (Docker ENV, CI, shell, .mcp.json) take precedence over this file.
# Relative paths are resolved against the repository root, whatever the working directory.
# Commented lines show the default, uncomment one only to change it.

# HTTP server. In Docker use HOST=0.0.0.0, otherwise the port is not reachable from outside.
#PORT=3000
#HOST=127.0.0.1

# SQLite file. Required, there is no default (db:setup fails without it).
# In Docker point it into a named volume, not a bind mount (WAL needs a local file system).
DB_PATH=./data/mifplace.db

# Express "trust proxy": who may set X-Forwarded-For. Unset when the app is reached directly
# (development). Behind Caddy in Docker: uniquelocal (see deploy/compose.yaml).
#TRUST_PROXY=

# Requests per client IP, a separate count for every endpoint; above it the answer is 429.
# Behind a proxy set TRUST_PROXY, otherwise all clients share one count. GET /health has no
# limit, the WebSocket has WS_MAX_CONNECTIONS. OTHER is everything else: the page, its scripts,
# styles and fonts, and the 404 page. To try many pixels locally, raise PIXELS in .env.
#RATE_LIMIT_PALETTE_PER_MINUTE=120
#RATE_LIMIT_CANVAS_SIZE_PER_MINUTE=120
#RATE_LIMIT_CANVAS_PER_MINUTE=20
#RATE_LIMIT_PIXELS_PER_MINUTE=10
#RATE_LIMIT_WAITLIST_SIGNUP_PER_HOUR=30
#RATE_LIMIT_WAITLIST_CONFIRM_PER_MINUTE=120
#RATE_LIMIT_WAITLIST_UNSUBSCRIBE_PER_MINUTE=120
#RATE_LIMIT_OTHER_PER_MINUTE=120
# The accounts (/api/auth, see docs/api.md). PASSWORD is /password/forgot, /reset and /change,
# AUTH_PER_MINUTE is /verify, /logout and /me; each route has its own count. Registration is
# generous because campus Wi-Fi shares addresses: the email limits protect the mailboxes.
#RATE_LIMIT_AUTH_REGISTER_PER_HOUR=100
#RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=60
#RATE_LIMIT_AUTH_PASSWORD_PER_HOUR=30
#RATE_LIMIT_AUTH_PER_MINUTE=120

# Live updates over WebSocket (/api/ws, see docs/api.md section 2). Pixels stored within
# WS_BATCH_MS go out as one message. The number of connected pages goes out at most once per
# WS_ONLINE_MS. The server pings a connection silent for WS_IDLE_PING_MS
# and drops it without a pong for WS_PONG_TIMEOUT_MS, checking every WS_LIVENESS_CHECK_MS.
# Above WS_MAX_CONNECTIONS new connections get 503; a client with more than
# WS_MAX_BUFFERED_BYTES unsent is dropped. A client reconnecting more than WS_MAX_BACKLOG
# events behind gets reset (it reloads the snapshot) instead of the missed events.
# The page's own origin is always allowed, WS_ALLOWED_ORIGINS adds others, comma-separated
# (e.g. http://localhost:5173).
#WS_BATCH_MS=100
#WS_ONLINE_MS=2000
#WS_IDLE_PING_MS=15000
#WS_PONG_TIMEOUT_MS=10000
#WS_LIVENESS_CHECK_MS=5000
#WS_MAX_CONNECTIONS=2000
#WS_MAX_BACKLOG=10000
#WS_MAX_BUFFERED_BYTES=262144
#WS_ALLOWED_ORIGINS=

# The waitlist (POST /api/waitlist) and the accounts (/api/auth), see docs/api.md. PUBLIC_URL
# is where the pages are, the email links point there; with https:// the session cookie is
# Secure. In development it defaults to http://localhost:PORT and the emails are printed to
# the console. Production does not start without PUBLIC_URL and SMTP_HOST: nothing works
# without sign-in. With "npm run dev" the page is on port 5173, so for links that open it set
# PUBLIC_URL=http://127.0.0.1:5173
#PUBLIC_URL=
# The waitlist routes. On by default in development, off in production unless set to true.
#WAITLIST_ENABLED=true
# Who may register an account: these domains and their subdomains, comma-separated.
#ALLOWED_EMAIL_DOMAINS=vu.lt
# All emails of the server together, per hour; above it the forms answer "try later". The
# SendPulse free plan sends 50 per hour, so the default stays below it. Raise it with the plan.
#MAIL_PER_HOUR=40
# Host, port and login from SendPulse → SMTP → Settings (smtp-pulse.com at the time of writing).
#SMTP_HOST=smtp-pulse.com
# 587 is the usual port; on our VPS outgoing 25, 465 and 587 are closed, there use 2525.
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#MAIL_FROM=vu.place <noreply@vu.place>

# An account for local development: the backend creates it at start, already confirmed, so you
# can sign in without an email, and the tools (dev:pixel-rain) sign in with it. Any address
# works here, nothing is sent to it. Not for production: the server refuses to start with these.
DEV_USER_EMAIL=dev@vu.lt
DEV_USER_PASSWORD=only-for-localhost
