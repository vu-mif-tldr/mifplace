# Copy to .env for local development: cp .env.example .env (npm run setup does it).
# One file for the whole repository: the backend, the db scripts, the tools and the MCP server read it.
# Real environment variables (Docker ENV, CI, shell, .mcp.json) take precedence over this file.
# Relative paths are resolved against the repository root, whatever the working directory.
# Commented lines show the default, uncomment one only to change it.

# HTTP server. In Docker use HOST=0.0.0.0, otherwise the port is not reachable from outside.
#PORT=3000
#HOST=127.0.0.1

# SQLite file. Required, there is no default (db:setup fails without it).
# In Docker point it into a named volume, not a bind mount (WAL needs a local file system).
DB_PATH=./data/mifplace.db

# Express "trust proxy": who may set X-Forwarded-For. Unset when the app is reached directly
# (development). Behind Caddy in Docker: uniquelocal (see deploy/compose.yaml).
#TRUST_PROXY=

# The waitlist (POST /api/waitlist, see docs/api.md). PUBLIC_URL is where the landing pages are,
# the email links point there. In development it defaults to http://localhost:PORT and the
# emails are printed to the console. In production the waitlist is on only when PUBLIC_URL is
# set, and then SMTP_HOST is required.
#PUBLIC_URL=
#SMTP_HOST=smtp-pulse.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#MAIL_FROM=vu.place <noreply@vu.place>
