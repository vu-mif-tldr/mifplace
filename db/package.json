{
  "name": "@mifplace/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@mifplace/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:setup:dev": "tsx src/setup-db.ts",
    "db:setup:prod": "node dist/setup-db.js"
  },
  "devDependencies": {
    "@mifplace/shared": "*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
