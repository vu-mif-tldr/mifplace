{
  "name": "@mifplace/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mifplace-db-setup": "dist/setup-db.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "dependencies": {
    "@mifplace/server-lib": "*",
    "@mifplace/shared": "*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  }
}
