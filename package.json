{
  "name": "mifplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server-lib",
    "db",
    "backend",
    "frontend",
    "tools"
  ],
  "scripts": {
    "prepare": "npm run build:libs",
    "dev": "concurrently -n libs,backend,frontend -c yellow,blue,green \"npm run build:libs -- --watch\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build:libs": "tsc -b shared/tsconfig.build.json server-lib/tsconfig.build.json db/tsconfig.build.json",
    "build": "npm run build:libs && npm run build -w backend -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "package": "bash scripts/package-release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24"
  }
}
