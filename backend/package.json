{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:setup:prod": "node dist/scripts/setup-db.js",
    "db:setup:dev": "tsx src/scripts/setup-db.ts",
    "db:seed:dev": "tsx src/scripts/seed-events.ts",
    "dev": "tsx watch src/server.ts",
    "watch": "npx tsc -p tsconfig.build.json --watch",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
