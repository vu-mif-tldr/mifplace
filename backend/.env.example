# Copy to .env for local development: cp .env.example .env
# Real environment variables (Docker ENV, CI, shell) take precedence over this file.
# Relative paths are resolved against the working directory (backend/ for npm scripts).
# Commented lines show the default, uncomment one only to change it.

# HTTP server. In Docker use HOST=0.0.0.0, otherwise the port is not reachable from outside.
#PORT=3000
#HOST=127.0.0.1

# SQLite file. Required, there is no default (db:setup fails without it).
# In Docker point it into a named volume, not a bind mount (WAL needs a local file system).
DB_PATH=./data/mifplace.db

# Directory with NNN_name.sql migrations.
MIGRATIONS_DIR=./migrations

# GET /api/canvas: brotli quality 0-11. Higher is smaller but slower, 11 takes seconds on a large canvas.
CANVAS_BROTLI_QUALITY=5 #allows 0-11, default 5

# Live updates over /api/ws.
# New pixels are collected and sent to all clients as one message at most this often (ms).
WS_BATCH_MS=200

# A client that missed more events than this gets "reload the canvas" instead of the events.
WS_MAX_CATCH_UP=10000

# A client that does not read its messages is dropped when this many bytes are queued for it.
WS_MAX_BUFFERED_BYTES=1048576

# Connections that did not answer the previous ping are closed; a ping goes out this often (ms).
WS_PING_MS=30000
